{
  "name": "wavebox-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run server:dev\" \"vite\"",
    "start": "concurrently -n server,web -c green,cyan \"npm run server\" \"vite\"",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "d1:dev": "wrangler dev",
    "d1:deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply wavebox-auth --local",
    "d1:migrate:remote": "wrangler d1 migrations apply wavebox-auth --remote",
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "server:install": "npm --prefix server install",
    "setup": "npm install && npm run server:install",
    "test:source": "node tests/source-audit.mjs",
    "test:matching": "node tests/matching.mjs",
    "test:api": "node tests/api-smoke.mjs",
    "test:security": "node tests/security-regressions.mjs",
    "test:security-queue": "node tests/queue-security.mjs",
    "test:player": "node tests/player-store.mjs",
    "test:radio": "node tests/radio-recommender.mjs",
    "test:radio-auth": "node tests/radio-auth-gate.mjs",
    "test:search-quality": "node tests/search-quality.mjs",
    "test:catalog": "node tests/catalog-selectors.mjs",
    "test:frontend": "node tests/frontend-architecture.mjs",
    "test:regressions": "node tests/regressions.mjs",
    "test:ui": "node tests/ui-regressions.mjs",
    "test": "npm run test:source && npm run test:player && npm run test:radio && npm run test:radio-auth && npm run test:search-quality && npm run test:catalog && npm run test:frontend && npm run test:regressions && npm run test:ui && npm run test:matching && npm run build && npm run test:api && npm run test:security && npm run test:security-queue"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "vite": "^6.4.3",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
